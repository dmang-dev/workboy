# --- toolchains / installs (regenerated by CI) ---
tools/
.pio/
__pycache__/
*.pyc

# --- KiCad per-session lock files (present while a project is open) ---
*.lck
~*.lck

# --- build artifacts ---
rom/workboy_homebrew.gb
rom/src/*.o
rom/src/*.lst
rom/src/*.rel
rom/src/*.sym
rom/src/*.map
rom/src/*.ihx
rom/src/*.asm
rom/src/*.cdb
rom/src/*.adb
rom/src/*.noi
firmware/_build.log
case/*.stl
case/*.step
kicad/workboy_board.step
kicad/jlc/
kicad/workboy.ses
kicad/workboy.dsn
kicad/cpl_raw.csv
kicad/drc*.rpt
kicad/freerouting.json

# --- reference PDFs (TCRF pages) ---
*.pdf

# --- leaked ROM + its runtime artifacts: do NOT commit or distribute ---
DMGWYE-0.781.*

# --- KiCad local/user state ---
*.kicad_prl

# --- local reference material: never committed, never distributed ---
# reference/ holds the third-party emulators used to validate the protocol
# (GBE+ and SameBoy, source + Windows builds). Each carries its own licence and
# upstream home -- see NOTICE. Fetch them yourself; nothing in this repo builds
# from them. EMULATOR_VALIDATION.md documents the expected layout.
reference/
*.zip
*.7z
# ...except the fab deliverable: JLCPCB wants a single zip upload.
# Re-zip it whenever the Gerbers are re-exported (see kicad/PCB_README.md).
!kicad/workboy_gerbers.zip

# --- KiCad/freerouting logs ---
kicad/logs/

# --- editor local-history + stray downloads ---
# VS Code "Local History" writes shadow copies next to sources.
.history/
**/.history/
# A 48 MB eVi installer once landed in this tree by accident; never commit
# installers or other unrelated binaries here.
*.exe

# --- personalized notes: kept locally, never published ---
# SHOPPING_LIST.md is written to one specific builder's kit and inventory.
# The generic, public version of it lives in README.md ("What you'll need").
SHOPPING_LIST.md
