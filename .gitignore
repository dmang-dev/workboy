# =============================================================================
#  reference/  --  local-only material. Nothing in here is ever committed.
# =============================================================================
# This directory holds everything the project consults but must not
# redistribute. Nothing in the build depends on it; you can delete it and the
# CI still passes. See NOTICE for the licensing rationale and
# EMULATOR_VALIDATION.md for the expected layout and upstream URLs.
#
#   reference/DMGWYE-0.781.gb/.sav   the leaked 1992 cartridge ROM + its save
#   reference/gbe_1_10/              GBE+ Windows build (protocol ground truth)
#   reference/gbe-plus-master/       GBE+ source
#   reference/sameboy_winsdl_v1.0.3/ SameBoy Windows build
#   reference/SameBoy-1.0.3/         SameBoy source
#   reference/*.pdf                  The Cutting Room Floor reference pages
#
reference/

# Belt and braces. The rules above already cover everything in reference/, but
# these three catch the same material if it is ever dropped somewhere else --
# and for the leaked ROM in particular, a redundant rule is cheap insurance.
DMGWYE-0.781.*
*.pdf
*.7z

# =============================================================================
#  Archives
# =============================================================================
*.zip
# ...except the fab deliverable: JLCPCB wants a single zip upload, so this one
# is tracked deliberately. Re-zip it whenever the Gerbers are re-exported
# (see kicad/PCB_README.md).
!kicad/workboy_gerbers.zip

# =============================================================================
#  Toolchains -- fetched by CI, never vendored
# =============================================================================
tools/
.pio/
__pycache__/
*.pyc

# =============================================================================
#  Build artifacts -- all regenerable from source
# =============================================================================
rom/workboy_homebrew.gb
rom/src/*.o
rom/src/*.lst
rom/src/*.rel
rom/src/*.sym
rom/src/*.map
rom/src/*.ihx
rom/src/*.asm
rom/src/*.cdb
rom/src/*.adb
rom/src/*.noi
firmware/_build.log
case/*.stl
case/*.step
kicad/workboy_board.step
kicad/jlc/
kicad/cpl_raw.csv

# =============================================================================
#  KiCad / Freerouting local state
# =============================================================================
# per-user board display state
*.kicad_prl
# per-session project locks, present while KiCad is open
*.lck
~*.lck
# Freerouting session + its input
kicad/workboy.ses
kicad/workboy.dsn
kicad/freerouting.json
# DRC reports: regenerate with kicad-cli, do not commit
kicad/drc*.rpt
kicad/logs/

# =============================================================================
#  Editor state and stray binaries
# =============================================================================
# VS Code "Local History" writes shadow copies next to sources.
.history/
**/.history/
# A 48 MB eVi installer once landed in this tree by accident; never commit
# installers or other unrelated binaries here.
*.exe

# =============================================================================
#  Personal notes -- kept local, never published
# =============================================================================
# SHOPPING_LIST.md is written to one specific builder's kit and inventory.
# The generic, public version of it lives in README.md ("What you'll need").
SHOPPING_LIST.md
