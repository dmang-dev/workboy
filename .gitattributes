# Normalise line endings so contributors on Windows/macOS/Linux don't produce
# whole-file diffs. Without this, core.autocrlf=true on Windows rewrites every
# generated artefact on checkout and every regeneration looks like a change.
* text=auto eol=lf

# Generated by layout/gen_layout.py — never hand-edit; regenerate instead.
case/key_positions.scad    text eol=lf linguist-generated=true
firmware/scancode_map.h    text eol=lf linguist-generated=true
kicad/key_positions.json   text eol=lf linguist-generated=true
layout/keymap.svg          text eol=lf linguist-generated=true

# Manufacturing outputs: keep byte-exact, never line-ending-normalised.
*.gbr    binary
*.drl    binary
*.step   binary
*.stl    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.zip    binary
*.7z     binary

# KiCad sources are text but should not be merged automatically.
*.kicad_pcb  text eol=lf -merge
*.kicad_pro  text eol=lf -merge
*.net        text eol=lf
